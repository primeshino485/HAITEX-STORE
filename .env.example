# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# MY STORE Administrator Secret
# Secret password for admin account k6379700@gmail.com
ADMIN_PASSWORD=

# NatCash Real Payment Integration (Number: 43854650)
NATCASH_API_KEY=""
NATCASH_SECRET_KEY=""
NATCASH_MERCHANT_ID=""
NATCASH_WEBHOOK_SECRET=""

# MonCash configuration (disabled by default)
MONCASH_ENABLED="false"

# Real SMTP Email Service (Used for customer verification codes and password reset emails)
# Standard SMTP configuration (Recommended):
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
# CRITICAL FOR GMAIL: You MUST use a 16-character "App Password" (Mot de passe d'application)
# generated at https://myaccount.google.com/apppasswords (requires 2-Step Verification).
# Using your standard Gmail login password will be rejected with "535-5.7.8 Username and Password not accepted".
SMTP_PASSWORD=""
SMTP_FROM=""

# Legacy variable aliases (also supported for backward compatibility):
EMAIL_HOST=""
EMAIL_PORT="587"
EMAIL_USER=""
EMAIL_PASSWORD=""
EMAIL_FROM=""

# Digital Accounts AES-256 Reversible Encryption Secret Key
DIGITAL_ACCOUNT_ENCRYPTION_KEY=""
